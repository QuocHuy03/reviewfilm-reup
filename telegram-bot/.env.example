# Copy file này thành ".env" rồi điền.

# 1) Token bot — nhắn @BotFather trên Telegram → /newbot → lấy token dạng 1234567:ABC...
TELEGRAM_BOT_TOKEN=

# 2) Chỉ cho phép ID của bạn (cách nhau bởi dấu phẩy). Chưa biết ID?
#    Cứ để trống chạy thử, nhắn bot 1 câu → nó in ID của bạn ra, rồi dán vào đây.
#    (ĐỂ TRỐNG = AI CŨNG DÙNG ĐƯỢC BOT — nên điền ID cho an toàn.)
TELEGRAM_ALLOWED_IDS=

# 3) Cổng của ReviewFilm Studio (mặc định 47651 — đổi nếu app chạy cổng khác)
RF_PORT=47651

# 4) Link trơn (không ghi gì) sẽ chạy chế độ nào: reup | vietsub | review
RF_TG_DEFAULT_MODE=reup

# 5) Ngôn ngữ đầu ra (vi, en, zh, ko, ja, th...)
RF_TG_TARGET_LANG=vi
